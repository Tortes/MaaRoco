+test('restoring fixed tabs preserves user options, queue order, custom tabs and running state', () => {
+  const savedTask = {
+    id: 'saved',
+    taskName: 'A',
+    enabled: false,
+    expanded: true,
+    optionValues: { choice: { type: 'select' as const, caseName: 'saved' } },
+  };
+  const newTask = { id: 'new', taskName: 'B', enabled: true, expanded: false, optionValues: {} };
+  const single = {
+    id: 'single',
+    name: 'old',
+    maarocoMode: 'single' as const,
+    selectedTasks: [savedTask],
+    isRunning: true,
+  };
+  const queue = {
+    id: 'queue',
+    name: 'old',
+    maarocoMode: 'queue' as const,
+    selectedTasks: [newTask, savedTask],
+    isRunning: false,
+  };
+  const custom = { id: 'custom', name: 'My config', selectedTasks: [savedTask], isRunning: false };
+  const tabs = normalizeMaaRocoTabs(
+    [single, queue, custom],
+    [{ ...savedTask, id: 'default' }, newTask],
+    { single: 'Single', queue: 'Queue' },
+    {},
+  );
+  assert.deepEqual(tabs[0].selectedTasks, [savedTask, newTask]);
+  assert.equal(tabs[0].isRunning, true);
+  assert.deepEqual(tabs[1].selectedTasks, [newTask, savedTask]);
+  assert.equal(tabs[2], custom);
+  assert.deepEqual(single.selectedTasks, [savedTask]);
+});
