+import type { Instance, SelectedTask } from '../types/interface';
+
+/** Restore the two built-in tabs while preserving every custom configuration. */
+export function normalizeMaaRocoTabs(
+  instances: Instance[],
+  allTasks: SelectedTask[],
+  names: { single: string; queue: string },
+  defaults: Pick<Instance, 'controllerName' | 'resourceName'>,
+): Instance[] {
+  const single = instances.find((instance) => instance.maarocoMode === 'single');
+  const queue = instances.find((instance) => instance.maarocoMode === 'queue');
+  const taskNames = new Set(single?.selectedTasks.map((task) => task.taskName));
+  const singleInstance: Instance = {
+    ...defaults,
+    isRunning: false,
+    ...single,
+    id: single?.id ?? 'maaroco-single',
+    name: names.single,
+    maarocoMode: 'single',
+    selectedTasks: [
+      ...(single?.selectedTasks ?? []),
+      ...allTasks.filter((task) => !taskNames.has(task.taskName)),
+    ],
+  };
+  const queueInstance: Instance = {
+    ...defaults,
+    isRunning: false,
+    ...queue,
+    id: queue?.id ?? 'maaroco-queue',
+    name: names.queue,
+    maarocoMode: 'queue',
+    selectedTasks:
+      queue?.selectedTasks ?? allTasks.map((task) => ({ ...task, id: `${task.id}-queue` })),
+  };
+  return [
+    singleInstance,
+    queueInstance,
+    ...instances
+      .filter((instance) => instance !== single && instance !== queue)
+      .map((instance) =>
+        instance.maarocoMode ? { ...instance, maarocoMode: undefined } : instance,
+      ),
+  ];
+}
