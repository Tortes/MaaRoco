+/// Encode arguments for the Windows command line accepted by ShellExecuteEx.
+#[cfg(any(windows, test))]
+pub fn windows_command_line(args: &[String]) -> String {
+    args.iter().map(|arg| {
+        if !arg.is_empty() && !arg.chars().any(|c| c.is_whitespace() || c == '"') {
+            return arg.clone();
+        }
+        // ShellExecuteEx expects a Windows command line, not shell syntax.
+        let mut quoted = String::from("\"");
+        let mut slashes = 0;
+        for character in arg.chars() {
+            if character == '\\' {
+                slashes += 1;
+                continue;
+            }
+            if character == '"' {
+                quoted.extend(std::iter::repeat_n('\\', slashes * 2 + 1));
+            } else {
+                quoted.extend(std::iter::repeat_n('\\', slashes));
+            }
+            slashes = 0;
+            quoted.push(character);
+        }
+        quoted.extend(std::iter::repeat_n('\\', slashes * 2));
+        quoted.push('"');
+        quoted
+    }).collect::<Vec<_>>().join(" ")
+}
+
+#[cfg(test)]
+mod command_line_tests {
+    use super::windows_command_line;
+
+    #[test]
+    fn elevation_retains_auto_run_and_instance_arguments() {
+        assert_eq!(windows_command_line(&["--autostart".into(), "--instance".into(),
+            "日常 任务".into(), "--quit-after-run".into()]),
+            "--autostart --instance \"日常 任务\" --quit-after-run");
+    }
+
+    #[test]
+    fn elevation_quotes_empty_arguments_quotes_and_trailing_slashes() {
+        assert_eq!(windows_command_line(&[String::new()]), "\"\"");
+        assert_eq!(windows_command_line(&["a\"b".into()]), "\"a\\\"b\"");
+        assert_eq!(windows_command_line(&["C:\\with space\\".into()]), "\"C:\\with space\\\\\"");
+        assert_eq!(windows_command_line(&["C:\\plain\\".into()]), "C:\\plain\\");
+    }
+}
