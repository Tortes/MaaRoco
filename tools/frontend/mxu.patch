+test('task ID ownership takes priority over the visible tab and the currently running tab', () => {
+  const instances = [
+    { id: 'queue', isRunning: false },
+    { id: 'single', isRunning: true },
+  ];
+  assert.equal(
+    resolveCallbackInstanceId('MaaRoco', 'single', instances, { queue: { 42: 'queue-task' } }, 42),
+    'queue',
+  );
+});
+
+test('callbacks arriving before task ID synchronization follow the only running tab', () => {
+  const instances = [
+    { id: 'queue', isRunning: true },
+    { id: 'single', isRunning: false },
+  ];
+  assert.equal(resolveCallbackInstanceId('MaaRoco', 'single', instances, {}, 42), 'queue');
+  assert.equal(resolveCallbackInstanceId('MaaRoco', null, instances, {}), 'queue');
+});
+
+test('ambiguous or stopped runs keep the visible-tab fallback', () => {
+  const instances = [
+    { id: 'queue', isRunning: true },
+    { id: 'single', isRunning: true },
+  ];
+  assert.equal(resolveCallbackInstanceId('MaaRoco', 'single', instances, {}, 42), 'single');
+  assert.equal(
+    resolveCallbackInstanceId(
+      'MaaRoco',
+      'single',
+      instances.map((instance) => ({ ...instance, isRunning: false })),
+      {},
+      42,
+    ),
+    'single',
+  );
+});
+
+test('callbacks for a removed tab do not recreate that tab through stale mappings', () => {
+  const instances = [{ id: 'single', isRunning: false }];
+  assert.equal(
+    resolveCallbackInstanceId('MaaRoco', 'single', instances, { removed: { 42: 'old-task' } }, 42),
+    'single',
+  );
+});
