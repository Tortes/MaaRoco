new file mode 100644
index 0000000..32a5daa
--- /dev/null
+++ b/src-tauri/src/commands/maaroco_migration.rs
@@ -0,0 +1,715 @@
+//! First-launch migration of portable MaaRoco MFAAvalonia installations.
+//!
+//! Keep the original files untouched, back up their exact bytes before writing
+//! MXU config, and never replace an existing MXU file. The Python installer uses
+//! the same field mapping in tools/migrate_mxu_config.py.
+
+use serde_json::{json, Map, Value};
+use sha2::{Digest, Sha256};
+use std::{
+    collections::{BTreeMap, BTreeSet},
+    fs::{self, OpenOptions},
+    io::{ErrorKind, Write},
+    path::{Path, PathBuf},
+};
+
+#[derive(Default)]
+struct Report {
+    warnings: Vec<String>,
+    timers: Vec<Value>,
+    unmapped_fields: BTreeMap<String, Vec<String>>,
+}
+
+fn items(value: &Value) -> Vec<Value> {
+    match value {
+        Value::Null => Vec::new(),
+        Value::Array(values) => values.clone(),
+        other => vec![other.clone()],
+    }
+}
+
+fn boolean(value: &Value) -> bool {
+    match value {
+        Value::Bool(value) => *value,
+        Value::String(value) => value.eq_ignore_ascii_case("true"),
+        _ => false,
+    }
+}
+
+fn text(value: &Value) -> String {
+    match value {
+        Value::Null => String::new(),
+        Value::String(value) => value.clone(),
+        value => value.to_string(),
+    }
+}
+
+fn array(value: &Value) -> &[Value] {
+    value.as_array().map(Vec::as_slice).unwrap_or(&[])
+}
+
+/// MFA writes ordinary JSON, but user-edited configs may contain JSONC.
+/// This scanner preserves comment-like characters and escaped quotes in strings.
+fn parse_config(bytes: &[u8]) -> Result<Value, String> {
+    let bytes = bytes.strip_prefix(&[0xef, 0xbb, 0xbf]).unwrap_or(bytes);
+    let mut stripped = Vec::with_capacity(bytes.len());
+    let (mut index, mut in_string, mut escaped) = (0, false, false);
+    while index < bytes.len() {
+        let byte = bytes[index];
+        if in_string {
+            stripped.push(byte);
+            if escaped {
+                escaped = false;
+            } else if byte == b'\\' {
+                escaped = true;
+            } else if byte == b'"' {
+                in_string = false;
+            }
+        } else if byte == b'"' {
+            in_string = true;
+            stripped.push(byte);
+        } else if byte == b'/' && bytes.get(index + 1) == Some(&b'/') {
+            index += 2;
+            while index < bytes.len() && !matches!(bytes[index], b'\r' | b'\n') {
+                index += 1;
+            }
+            stripped.push(b' ');
+            continue;
+        } else if byte == b'/' && bytes.get(index + 1) == Some(&b'*') {
+            index += 2;
+            while index + 1 < bytes.len() && &bytes[index..index + 2] != b"*/" {
+                index += 1;
+            }
+            if index + 1 >= bytes.len() {
+                return Err("Unterminated JSONC comment".to_string());
+            }
+            index += 2;
+            stripped.push(b' ');
+            continue;
+        } else {
+            stripped.push(byte);
+        }
+        index += 1;
+    }
+    let mut cleaned = Vec::with_capacity(stripped.len());
+    in_string = false;
+    escaped = false;
+    for (index, byte) in stripped.iter().copied().enumerate() {
+        if in_string {
+            cleaned.push(byte);
+            if escaped {
+                escaped = false;
+            } else if byte == b'\\' {
+                escaped = true;
+            } else if byte == b'"' {
+                in_string = false;
+            }
+        } else if byte == b'"' {
+            in_string = true;
+            cleaned.push(byte);
+        } else if byte != b','
+            || !stripped[index + 1..]
+                .iter()
+                .copied()
+                .find(|byte| !byte.is_ascii_whitespace())
+                .is_some_and(|byte| matches!(byte, b'}' | b']'))
+        {
+            cleaned.push(byte);
+        }
+    }
+    let value: Value = serde_json::from_slice(&cleaned).map_err(|error| error.to_string())?;
+    if !value.is_object() {
+        return Err("Expected a configuration object".to_string());
+    }
+    Ok(value)
+}
+
+fn default_option(definition: &Value) -> Value {
+    let kind = definition["type"].as_str().unwrap_or("select");
+    let cases = array(&definition["cases"]);
+    let default = definition
+        .get("default_case")
+        .cloned()
+        .unwrap_or_else(|| cases.first().map(|case| case["name"].clone()).unwrap_or(json!("")));
+    match kind {
+        "input" | "hotkey" => {
+            let values: Map<String, Value> = array(&definition["inputs"])
+                .iter()
+                .filter_map(|item| Some((item["name"].as_str()?.to_string(), json!(text(&item["default"])))))
+                .collect();
+            json!({"type": kind, "values": values})
+        }
+        "checkbox" => json!({"type": "checkbox", "caseNames": items(&definition["default_case"])}),
+        "switch" => json!({"type": "switch", "value": matches!(default.as_str(), Some("Yes" | "yes" | "Y" | "y"))}),
+        _ => json!({"type": "select", "caseName": default}),
+    }
+}
+
+fn option_defaults(names: &Value, definitions: &Value) -> Map<String, Value> {
+    fn visit(name: &str, definitions: &Value, result: &mut Map<String, Value>) {
+        if result.contains_key(name) {
+            return;
+        }
+        let Some(definition) = definitions.get(name) else {
+            return;
+        };
+        result.insert(name.to_string(), default_option(definition));
+        for case in array(&definition["cases"]) {
+            for child in items(&case["option"]) {
+                if let Some(child) = child.as_str() {
+                    visit(child, definitions, result);
+                }
+            }
+        }
+    }
+    let mut result = Map::new();
+    for name in items(names) {
+        if let Some(name) = name.as_str() {
+            visit(name, definitions, &mut result);
+        }
+    }
+    result
+}
+
+fn convert_options(saved: &Value, definitions: &Value, report: &mut Report, context: &str) -> Map<String, Value> {
+    let mut result = Map::new();
+    for item in items(saved) {
+        let item = if item.is_string() { json!({"name": item}) } else { item };
+        let Some(name) = item["name"].as_str() else {
+            report.warnings.push(format!("{context}: invalid option retained in MFA backup"));
+            continue;
+        };
+        if let Some(definition) = definitions.get(name) {
+            let mut value = default_option(definition);
+            let kind = value["type"].as_str().unwrap_or("select").to_string();
+            let cases = array(&definition["cases"]);
+            match kind.as_str() {
+                "input" | "hotkey" => {
+                    if let Some(data) = item["data"].as_object() {
+                        let inputs = value["values"].as_object_mut().unwrap();
+                        for (key, raw) in data {
+                            if inputs.contains_key(key) {
+                                inputs.insert(key.clone(), json!(text(raw)));
+                            } else {
+                                report.warnings.push(format!("{context}/{name}: unknown input {key:?} retained in MFA backup"));
+                            }
+                        }
+                    }
+                }
+                "checkbox" if !item["selected_cases"].is_null() => {
+                    let mut selected = Vec::new();
+                    for case in items(&item["selected_cases"]) {
+                        if cases.iter().any(|definition| definition["name"] == case) {
+                            if !selected.contains(&case) {
+                                selected.push(case);
+                            }
+                        } else {
+                            report.warnings.push(format!("{context}/{name}: unknown checkbox case retained in MFA backup"));
+                        }
+                    }
+                    value["caseNames"] = Value::Array(selected);
+                }
+                "select" | "switch" if !item["index"].is_null() => {
+                    if let Some(case) = item["index"].as_u64().and_then(|index| cases.get(index as usize)) {
+                        if kind == "select" {
+                            value["caseName"] = case["name"].clone();
+                        } else {
+                            value["value"] = json!(matches!(case["name"].as_str(), Some("Yes" | "yes" | "Y" | "y")));
+                        }
+                    } else {
+                        report.warnings.push(format!("{context}/{name}: invalid index retained in MFA backup; using interface default"));
+                    }
+                }
+                _ => {}
+            }
+            result.insert(name.to_string(), value);
+        } else {
+            report.warnings.push(format!("{context}: unknown option {name:?} retained in MFA backup"));
+        }
+        result.extend(convert_options(&item["sub_options"], definitions, report, context));
+    }
+    result
+}
+
+fn convert_tasks(saved: &Value, interface: &Value, report: &mut Report, identifier: &str) -> Vec<Value> {
+    let mut result = Vec::new();
+    for (index, item) in items(saved).iter().enumerate() {
+        let Some(name) = item["name"].as_str() else {
+            report.warnings.push(format!("{identifier}: invalid task retained in MFA backup"));
+            continue;
+        };
+        let Some(definition) = array(&interface["task"]).iter().find(|definition| definition["name"] == name) else {
+            report.warnings.push(format!("{identifier}: unsupported task {name:?} retained in MFA backup"));
+            continue;
+        };
+        let mut options = option_defaults(&definition["option"], &interface["option"]);
+        options.extend(convert_options(&item["option"], &interface["option"], report, &format!("{identifier}/{name}")));
+        let mut task = json!({"id": format!("{identifier}-task-{index}"), "taskName": name,
+            "enabled": boolean(&item["default_check"]), "optionValues": options, "expanded": false});
+        if let Some(custom_name) = item["display_name_override"].as_str().filter(|name| !name.is_empty()) {
+            task["customName"] = json!(custom_name);
+        }
+        for field in ["remark", "advanced", "pipeline_override", "repeat_count"] {
+            if item.get(field).is_some_and(|value| !value.is_null() && value != &json!(false) && value != &json!([]) && value != &json!({})) {
+                report.warnings.push(format!("{identifier}/{name}: {field} retained in MFA backup"));
+            }
+        }
+        result.push(task);
+    }
+    result
+}
+
+fn convert_instance(identifier: &str, saved: &Value, interface: &Value, report: &mut Report) -> Value {
+    let mode = if identifier == "quick-tasks" || saved["MaaRoco.TaskMode"] == "quick" { "single" } else { "queue" };
+    let mut name = saved["InstanceName"].as_str().filter(|name| !name.is_empty()).unwrap_or_else(|| {
+        if mode == "single" { "单任务" } else if identifier == "default" { "任务队列" } else { identifier }
+    });
+    if identifier == "default" && matches!(name, "default" | "Default" | "配置 1" | "配置1" | "Config 1") {
+        name = "任务队列";
+    }
+    let resource = saved["Resource"].as_str().filter(|name| !name.is_empty())
+        .or_else(|| array(&interface["resource"]).first().and_then(|resource| resource["name"].as_str()))
+        .unwrap_or("default");
+    if !array(&interface["resource"]).iter().any(|item| item["name"] == resource) {
+        report.warnings.push(format!("{identifier}: custom resource {resource:?} retained; resource definition must remain available"));
+    }
+    let window = saved["DesktopWindowName"].as_str().filter(|name| {
+        !name.is_empty() && !matches!(*name, "Program Manager" | "程序管理器") && saved["DesktopWindowClassName"] != "Progman"
+    }).unwrap_or("洛克王国：世界");
+    let mut instance = json!({"id": format!("mfa-{identifier}"), "name": name, "maarocoMode": mode,
+        "controllerName": "Win32-Interception", "resourceName": resource,
+        "savedDevice": {"windowName": window}, "tasks": convert_tasks(&saved["TaskItems"], interface, report, identifier)});
+    if let Some(path) = saved["ConnectedProgramPath"].as_str().filter(|path| !path.is_empty()) {
+        instance["savedDevice"]["connectedProgramPath"] = json!(path);
+    }
+    for key in ["ResourceOptionItems", "ControllerOptionItems", "BeforeTask", "AfterTask", "GlobalOptionItems"] {
+        if saved.get(key).is_some_and(|value| !value.is_null() && value != &json!({}) && value != &json!([])) {
+            report.warnings.push(format!("{identifier}: {key} retained in MFA backup (MXU has no matching per-instance field)"));
+        }
+    }
+    let mapped = ["InstanceName", "Resource", "TaskItems", "CurrentTasks", "MaaRoco.TaskMode",
+        "DesktopWindowName", "DesktopWindowClassName", "ConnectedProgramPath", "CurrentControllerName",
+        "CurrentController", "Win32ControlMouseType", "Win32ControlKeyboardType", "Win32ControlScreenCapType",
+        "UI.LiveView.EnableLiveView", "MaaRoco.TaskModesInitialized", "MaaRoco.LauncherTabInitialized"];
+    if let Some(object) = saved.as_object() {
+        let unmapped: Vec<String> = object.keys().filter(|key| !mapped.contains(&key.as_str())).cloned().collect();
+        if !unmapped.is_empty() {
+            report.unmapped_fields.insert(identifier.to_string(), unmapped);
+        }
+    }
+    instance
+}
+
+fn timer_number(key: &str) -> Option<u32> {
+    let remainder = key.strip_prefix("Timer.Timer")?;
+    let digits: String = remainder.chars().take_while(char::is_ascii_digit).collect();
+    let suffix = &remainder[digits.len()..];
+    if !suffix.is_empty() && suffix != "Time" && !suffix.starts_with('.') {
+        return None;
+    }
+    digits.parse().ok()
+}
+
+fn parse_time(value: &Value) -> Option<String> {
+    let parts: Vec<&str> = value.as_str()?.split(':').collect();
+    if !(parts.len() == 2 || parts.len() == 3 && parts[2] == "00") {
+        return None;
+    }
+    if parts[0].len() > 2 || parts[1].len() > 2 {
+        return None;
+    }
+    let hour: u8 = parts[0].parse().ok()?;
+    let minute: u8 = parts[1].parse().ok()?;
+    (hour < 24 && minute < 60).then(|| format!("{hour:02}:{minute:02}"))
+}
+
+fn migrate_timers(global: &Value, instances: &mut [Value], report: &mut Report) {
+    let Some(global) = global.as_object() else { return };
+    let numbers: BTreeSet<u32> = global.keys().filter_map(|key| timer_number(key)).collect();
+    for number in numbers {
+        let prefix = format!("Timer.Timer{number}");
+        let raw: Map<String, Value> = global.iter().filter(|(key, _)| {
+            *key == &prefix || *key == &format!("{prefix}Time") || key.starts_with(&format!("{prefix}."))
+        }).map(|(key, value)| (key.clone(), value.clone())).collect();
+        let get = |suffix: &str| raw.get(&format!("{prefix}{suffix}")).cloned().unwrap_or(Value::Null);
+        let enabled = boolean(&get(""));
+        let mut entry = json!({"timer": number, "source": raw, "status": "retained"});
+        if !enabled && get("Time").is_null() {
+            entry["reason"] = json!("Unused timer");
+            report.timers.push(entry);
+            continue;
+        }
+        let target = get(".Config").as_str().map(|identifier| format!("mfa-{identifier}"));
+        let target_index = instances.iter().position(|instance| Some(text(&instance["id"])) == target);
+        let schedule_text = get(".Schedule").as_str().filter(|schedule| !schedule.is_empty()).unwrap_or("0||").to_string();
+        let schedule: Vec<&str> = schedule_text.split('|').collect();
+        let time = parse_time(&get("Time"));
+        let mut reason = if target_index.is_none() {
+            Some("Timer target is missing or implicit")
+        } else if !get(".Action").is_null() && text(&get(".Action")) != "0" {
+            Some("MXU schedule policies cannot stop tasks")
+        } else if boolean(&get(".StopConnectedProcess")) || boolean(&get(".StopMFA")) {
+            Some("MXU schedule policies cannot stop a process or MFA")
+        } else if time.is_none() {
+            Some("Invalid or missing start time")
+        } else if !matches!(schedule[0], "0" | "1") {
+            Some("Monthly or unknown timer schedule is unsupported")
+        } else { None };
+        let mut days: Vec<u8> = (0..7).collect();
+        if reason.is_none() && schedule[0] == "1" {
+            let tokens: Vec<&str> = schedule.get(1).unwrap_or(&"").split(',').collect();
+            let parsed: Option<BTreeSet<u8>> = tokens.iter().map(|token| {
+                token.parse::<u8>().ok().filter(|day| *day < 7)
+            }).collect();
+            if let Some(parsed) = parsed.filter(|days| !days.is_empty()) {
+                days = parsed.into_iter().collect();
+            } else {
+                reason = Some("Invalid or empty weekly schedule");
+            }
+        }
+        if let Some(reason) = reason {
+            entry["reason"] = json!(reason);
+            report.warnings.push(format!("Timer {number}: {reason}; original timer retained in MFA backup"));
+        } else {
+            let instance = &mut instances[target_index.unwrap()];
+            if !instance["schedulePolicies"].is_array() {
+                instance["schedulePolicies"] = json!([]);
+            }
+            instance["schedulePolicies"].as_array_mut().unwrap().push(json!({
+                "id": format!("mfa-timer-{number}"), "name": format!("MFA 定时任务 {number}"),
+                "enabled": enabled, "weekdays": days, "times": [time.unwrap()]
+            }));
+            entry["status"] = json!("migrated");
+        }
+        report.timers.push(entry);
+    }
+}
+
+fn stable_version(version: &str) -> bool {
+    let parts: Vec<&str> = version.strip_prefix('v').unwrap_or(version).split('.').collect();
+    parts.len() == 3 && parts.iter().all(|part| !part.is_empty() && part.chars().all(|character| character.is_ascii_digit()))
+}
+
+fn build_config(saved: &BTreeMap<String, Value>, settings: &Value, global: &Value, interface: &Value, report: &mut Report) -> Value {
+    let empty = json!({});
+    let queue_saved = saved.get("default").unwrap_or(settings);
+    let queue = convert_instance("default", queue_saved, interface, report);
+    let mut single = convert_instance("quick-tasks", saved.get("quick-tasks").unwrap_or(&empty), interface, report);
+    let options_by_name = |tasks: &Value| -> BTreeMap<String, Value> {
+        array(tasks).iter().filter_map(|task| Some((task["taskName"].as_str()?.to_string(), task["optionValues"].clone()))).collect()
+    };
+    let queue_options = options_by_name(&queue["tasks"]);
+    let launcher_tasks = convert_tasks(&saved.get("launch-game").unwrap_or(&empty)["TaskItems"], interface, report, "launch-game");
+    let launcher_options = options_by_name(&Value::Array(launcher_tasks));
+    let single_tasks: BTreeMap<String, Value> = array(&single["tasks"]).iter()
+        .filter_map(|task| Some((task["taskName"].as_str()?.to_string(), task.clone()))).collect();
+    let mut tasks = Vec::new();
+    for (index, definition) in array(&interface["task"]).iter().enumerate() {
+        let Some(name) = definition["name"].as_str() else { continue };
+        let mut task = if let Some(task) = single_tasks.get(name) {
+            task.clone()
+        } else {
+            let mut options = option_defaults(&definition["option"], &interface["option"]);
+            if let Some(saved_options) = launcher_options.get(name).or_else(|| queue_options.get(name)).and_then(Value::as_object) {
+                options.extend(saved_options.clone());
+            }
+            json!({"taskName": name, "enabled": boolean(&definition["default_check"]), "optionValues": options, "expanded": false})
+        };
+        task["id"] = json!(format!("quick-tasks-task-{index}"));
+        tasks.push(task);
+    }
+    single["tasks"] = Value::Array(tasks);
+    if !saved.contains_key("quick-tasks") {
+        single["resourceName"] = queue["resourceName"].clone();
+        single["savedDevice"] = queue["savedDevice"].clone();
+    }
+    let mut instances = vec![single, queue];
+    let mut ordered: Vec<String> = ["Instances.Order", "Instances.List"].iter()
+        .flat_map(|key| global[key].as_str().unwrap_or("").split(',').map(str::to_string)).collect();
+    ordered.extend(saved.keys().cloned());
+    let mut seen = BTreeSet::from(["default".to_string(), "quick-tasks".to_string()]);
+    for identifier in ordered {
+        if seen.insert(identifier.clone()) {
+            if let Some(value) = saved.get(&identifier) {
+                instances.push(convert_instance(&identifier, value, interface, report));
+            }
+        }
+    }
+    migrate_timers(global, &mut instances, report);
+    let language = settings["CurrentLanguage"].as_str().filter(|language| matches!(*language,
+        "system" | "zh-CN" | "zh-TW" | "en-US" | "ja-JP" | "ko-KR")).unwrap_or("zh-CN");
+    let active = format!("mfa-{}", global["Instances.LastActive"].as_str().unwrap_or("quick-tasks"));
+    let active = if instances.iter().any(|instance| instance["id"] == active) { active } else { "mfa-quick-tasks".to_string() };
+    let mut config = json!({"version": "1.0", "instances": instances,
+        "settings": {"theme": "system", "language": language, "onboardingCompleted": true,
+            "hotkeys": {"startTasks": "F10", "stopTasks": "F11", "globalEnabled": true},
+            "screenshotPanelExpanded": false, "screenshotFrameRate": "1",
+            "mirrorChyan": {"cdk": "", "channel": if stable_version(interface["version"].as_str().unwrap_or("")) { "stable" } else { "beta" }}},
+        "interfaceTaskSnapshot": array(&interface["task"]).iter().map(|task| task["name"].clone()).collect::<Vec<_>>(),
+        "presetInitialized": true, "lastActiveInstanceId": active});
+    let global_options = convert_options(&settings["GlobalOptionItems"], &interface["option"], report, "global");
+    if !global_options.is_empty() {
+        config["globalOptionValues"] = Value::Object(global_options);
+    }
+    for key in ["DownloadCDK", "GitHubToken"] {
+        if settings[key].as_str().is_some_and(|secret| !secret.is_empty()) {
+            report.warnings.push(format!("{key}: MFA encrypted credential retained in backup; re-enter it in MXU settings"));
+        }
+    }
+    config
+}
+
+fn config_filename(interface: &Value) -> String {
+    match interface["name"].as_str() {
+        Some(name) => format!("mxu-{}.json", name.chars().map(|character| {
+            if matches!(character, '/' | '\\' | '.' | ':') { '_' } else { character }
+        }).collect::<String>()),
+        None => "mxu.json".to_string(),
+    }
+}
+
+/// Called by AppConfigState only when the project MXU config is absent.
+/// No MFA files means no migration: the normal MXU first-run flow remains active.
+pub fn migrate_legacy_config(data_dir: &Path, interface: &Value) -> Result<Option<Value>, String> {
+    let destination = data_dir.join("config").join(config_filename(interface));
+    if destination.exists() {
+        return Ok(None);
+    }
+    let mut paths: Vec<PathBuf> = ["config/config.json", "appsettings.json"].iter()
+        .map(|relative| data_dir.join(relative)).filter(|path| path.is_file()).collect();
+    let instance_dir = data_dir.join("config/instances");
+    if instance_dir.is_dir() {
+        let mut instances: Vec<PathBuf> = fs::read_dir(&instance_dir).map_err(|error| error.to_string())?
+            .map(|entry| entry.map(|entry| entry.path())).collect::<Result<_, _>>().map_err(|error| error.to_string())?;
+        instances.retain(|path| path.is_file() && path.extension().is_some_and(|extension| extension == "json"));
+        instances.sort();
+        paths.extend(instances);
+    }
+    if paths.is_empty() {
+        return Ok(None);
+    }
+    let mut sources = Vec::new();
+    let mut digest = Sha256::new();
+    for path in paths {
+        let relative = path.strip_prefix(data_dir).map_err(|error| error.to_string())?.to_path_buf();
+        let bytes = fs::read(&path).map_err(|error| format!("Read MFA config {}: {error}", path.display()))?;
+        digest.update(relative.to_string_lossy().replace('\\', "/").as_bytes());
+        digest.update([0]);
+        digest.update(&bytes);
+        sources.push((relative, bytes));
+    }
+    let backup = data_dir.join("config/backups").join(format!("mfa-to-mxu-{}", &format!("{:x}", digest.finalize())[..16]));
+    let mut source_files = Vec::new();
+    let mut saved = BTreeMap::new();
+    let (mut settings, mut global) = (json!({}), json!({}));
+    let mut report = Report::default();
+    // Back up all sources before parsing or publishing any converted config.
+    for (relative, bytes) in &sources {
+        let target = backup.join(relative);
+        fs::create_dir_all(target.parent().unwrap()).map_err(|error| error.to_string())?;
+        match OpenOptions::new().write(true).create_new(true).open(&target) {
+            Ok(mut file) => {
+                file.write_all(bytes).and_then(|_| file.sync_all()).map_err(|error| format!("Back up MFA config {}: {error}", target.display()))?;
+            }
+            Err(error) if error.kind() == ErrorKind::AlreadyExists => {
+                if fs::read(&target).map_err(|error| error.to_string())? != *bytes {
+                    return Err(format!("Conflicting MFA backup: {}", target.display()));
+                }
+            }
+            Err(error) => return Err(format!("Back up MFA config {}: {error}", target.display())),
+        }
+        source_files.push(json!({"path": relative.to_string_lossy().replace('\\', "/"), "sha256": format!("{:x}", Sha256::digest(bytes))}));
+    }
+    for (relative, bytes) in sources {
+        let value = parse_config(&bytes).unwrap_or_else(|error| {
+            report.warnings.push(format!("{}: {error}; exact file retained in MFA backup", relative.display()));
+            json!({})
+        });
+        if relative == Path::new("config/config.json") {
+            settings = value;
+        } else if relative == Path::new("appsettings.json") {
+            global = value;
+        } else if let Some(identifier) = relative.file_stem().and_then(|stem| stem.to_str()) {
+            saved.insert(identifier.to_string(), value);
+        }
+    }
+    let config = build_config(&saved, &settings, &global, interface, &mut report);
+    let report_path = backup.join("migration-report.json");
+    let report_json = json!({"status": "migrated", "version": interface["version"],
+        "config_path": destination.to_string_lossy(), "backup_path": backup.to_string_lossy(),
+        "report_path": report_path.to_string_lossy(), "source_files": source_files,
+        "warnings": report.warnings, "timers": report.timers, "unmapped_fields": report.unmapped_fields});
+    fs::write(&report_path, serde_json::to_vec_pretty(&report_json).map_err(|error| error.to_string())?)
+        .map_err(|error| format!("Save MFA migration report: {error}"))?;
+    let content = serde_json::to_vec_pretty(&config).map_err(|error| error.to_string())?;
+    match OpenOptions::new().write(true).create_new(true).open(&destination) {
+        Ok(mut file) => {
+            file.write_all(&content).and_then(|_| file.sync_all()).map_err(|error| format!("Save MXU config: {error}"))?;
+        }
+        Err(error) if error.kind() == ErrorKind::AlreadyExists => return Ok(None),
+        Err(error) => return Err(format!("Save MXU config: {error}")),
+    }
+    log::info!("MaaRoco: migrated MFA config; recovery files: {}", backup.display());
+    for warning in &report.warnings {
+        log::warn!("MaaRoco migration: {warning}");
+    }
+    Ok(Some(config))
+}
