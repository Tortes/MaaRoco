+test('queue execution keeps the checked tasks in list order; single mode ignores checks', () => {
+  const tasks = [
+    { id: 'a', taskName: 'A', enabled: false, expanded: false, optionValues: {} },
+    { id: 'b', taskName: 'B', enabled: true, expanded: false, optionValues: {} },
+    { id: 'c', taskName: 'C', enabled: true, expanded: false, optionValues: {} },
+  ];
+  assert.deepEqual(
+    filterTasksForRun(tasks).map((task) => task.id),
+    ['b', 'c'],
+  );
+  assert.deepEqual(
+    filterTasksForRun(tasks, { singleTaskId: 'a' }).map((task) => task.id),
+    ['a'],
+  );
+});
