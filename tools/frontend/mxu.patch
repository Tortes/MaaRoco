--- /dev/null
+++ b/src/utils/callbackInstance.ts
@@ -0,0 +1,27 @@
+interface CallbackInstance {
+  id: string;
+  isRunning: boolean;
+}
+
+/** MaaRoco task callbacks belong to the executing tab even when another tab is visible. */
+export function resolveCallbackInstanceId(
+  projectName: string | undefined,
+  activeInstanceId: string | null,
+  instances: readonly CallbackInstance[],
+  taskMappings: Readonly<Record<string, Readonly<Record<number, string>>>>,
+  taskId?: number,
+): string | null {
+  if (projectName !== 'MaaRoco') return activeInstanceId;
+
+  if (taskId !== undefined) {
+    const owners = instances.filter(
+      (instance) => taskMappings[instance.id]?.[taskId] !== undefined,
+    );
+    if (owners.length === 1) return owners[0].id;
+  }
+
+  // A Starting callback can arrive before the backend-state refresh supplies its mapping.
+  const running = instances.filter((instance) => instance.isRunning);
+  if (running.length === 1) return running[0].id;
+  return activeInstanceId;
+}
