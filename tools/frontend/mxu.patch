+    use super::connection_timeout;
+
+    #[test]
+    fn native_handshake_is_bounded_without_shortening_explicit_short_timeouts() {
+        assert_eq!(connection_timeout(-1, true), 5_000);
+        assert_eq!(connection_timeout(20_000, true), 5_000);
+        assert_eq!(connection_timeout(500, true), 500);
+    }
+
+    #[test]
+    fn generic_agent_timeout_is_preserved() {
+        assert_eq!(connection_timeout(-1, false), -1);
+        assert_eq!(connection_timeout(20_000, false), 20_000);
+    }
+}
