+        assert!(runtime.stop_started_at.is_some());
+
+        runtime.task_run_state.overall_status = Some("Failed".to_string());
+        runtime.task_run_state.statuses.insert(
+            "queue-b".to_string(),
+            "failed".to_string(),
+        );
+        runtime.maaroco_queue.active = false;
+        assert_eq!(
+            http_instance_state_snapshot(&mut runtime)["is_running"],
+            false,
+        );
+        assert!(!runtime.stop_in_progress);
+        assert!(runtime.stop_started_at.is_none());
+    }
+}
