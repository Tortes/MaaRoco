+/// Bound the native startup handshake while retaining generic timeout settings.
+fn connection_timeout(timeout: i64, bounded_startup: bool) -> i64 {
+    if bounded_startup {
+        if timeout < 0 { 5_000 } else { timeout.min(5_000) }
+    } else {
+        timeout
+    }
+}
+
