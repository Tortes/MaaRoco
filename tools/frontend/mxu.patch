+++ b/tests/maarocoTaskInteraction.test.ts
@@ -0,0 +1,240 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createLatestTaskRequest } from '../src/utils/latestTaskRequest.ts';
+import { getTaskDropIndex } from '../src/utils/taskDock.ts';
+import { filterTasksForRun } from '../src/utils/taskRunFilter.ts';
+import { normalizeMaaRocoTabs } from '../src/utils/maarocoTabs.ts';
+import { getMaaRocoErrorKey } from '../src/utils/maarocoErrors.ts';
+import { resolveCallbackInstanceId } from '../src/utils/callbackInstance.ts';
+
+test('switch requests finish stopping before the latest task starts', async () => {
+  const requests = createLatestTaskRequest();
+  const events: string[] = [];
+  let finishStopping!: () => void;
+  const stopping = new Promise<void>((resolve) => {
+    finishStopping = resolve;
+  });
+  const first = requests.run(async (isCancelled) => {
+    events.push('stop');
+    await stopping;
+    if (isCancelled()) return false;
+    events.push('first');
+    return true;
+  });
+  await Promise.resolve();
+  await Promise.resolve();
+  const second = requests.run(async () => {
+    events.push('second');
+    return true;
+  });
+  const third = requests.run(async () => {
+    events.push('third');
+    return true;
+  });
+  finishStopping();
+  assert.equal(await first, false);
+  assert.equal(await second, false);
+  assert.equal(await third, true);
+  assert.deepEqual(events, ['stop', 'third']);
+});
+
+test('global stop cancels a pending task start', async () => {
+  const requests = createLatestTaskRequest();
+  let release!: () => void;
+  const ready = new Promise<void>((resolve) => {
+    release = resolve;
+  });
+  let started = false;
+  const pending = requests.run(async (isCancelled) => {
+    await ready;
+    if (isCancelled()) return false;
+    started = true;
+    return true;
+  });
+  requests.cancel();
+  release();
+  assert.equal(await pending, false);
+  assert.equal(started, false);
+});
+
+test('a failed request does not block a later switch', async () => {
+  const requests = createLatestTaskRequest();
+  await assert.rejects(
+    requests.run(async () => {
+      throw new Error('stop failed');
+    }),
+  );
+  assert.equal(await requests.run(async () => true), true);
+});
