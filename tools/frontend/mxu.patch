@@ -0,0 +1,23 @@
+/** Serialize task switches; only the most recent click may start a new task. */
+export function createLatestTaskRequest() {
+  let revision = 0;
+  let pending: Promise<boolean> = Promise.resolve(false);
+
+  return {
+    cancel() {
+      revision += 1;
+    },
+    run(action: (isCancelled: () => boolean) => Promise<boolean>): Promise<boolean> {
+      const requestRevision = ++revision;
+      const isCancelled = () => requestRevision !== revision;
+      const result = pending
+        .catch(() => false)
+        .then(() => {
+          if (isCancelled()) return false;
+          return action(isCancelled);
+        });
+      pending = result;
+      return result;
+    },
+  };
+}
