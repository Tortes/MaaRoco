diff --git a/src-tauri/src/commands/maaroco.rs b/src-tauri/src/commands/maaroco.rs
new file mode 100644
index 0000000..9b72914
--- /dev/null
+++ b/src-tauri/src/commands/maaroco.rs
@@ -0,0 +1,397 @@
+//! MaaRoco's Windows tasks use the desktop to launch, then a fresh game window.
+//! Submit one task at a time so that each tasker is bound to the correct controller.
+
+use std::collections::HashMap;
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+use maa_framework::common::{MaaStatus, Win32InputMethod, Win32ScreencapMethod};
+use maa_framework::job::Job;
+use maa_framework::tasker::Tasker;
+use tauri::Manager;
+
+use super::types::{AgentConfig, ControllerConfig, ControllerInfo, MaaState, TaskConfig, Win32Window};
+use super::utils::{emit_state_changed, get_maafw_dir};
+
+pub const INTERCEPTION_INPUT: u64 = Win32InputMethod::INTERCEPTION.bits();
+pub(super) const QUEUE_CANCELLED: &str = "MaaRoco task queue was cancelled [[hint:maaroco_queue_cancelled]]";
+
+#[derive(Debug, Default)]
+pub struct MaarocoQueue {
+    pub active: bool,
+    pub cancelled: bool,
+    pub completion_sent: bool,
+}
+
+impl MaarocoQueue {
+    pub fn begin(&mut self) -> Result<(), String> {
+        if self.active {
+            return Err("MaaRoco task queue is already running".into());
+        }
+        self.active = true;
+        self.cancelled = false;
+        self.completion_sent = false;
+        Ok(())
+    }
+
+    pub fn cancel(&mut self) {
+        if self.active {
+            self.cancelled = true;
+        }
+    }
+
+    pub fn is_running(&self, tasker_running: bool) -> bool {
+        self.active || tasker_running
+    }
+
+    pub fn callback_can_complete(&self) -> bool {
+        !self.active && !self.completion_sent
+    }
+
+    fn begin_finish(&mut self) -> bool {
+        if self.completion_sent {
+            return false;
+        }
+        self.completion_sent = true;
+        true
+    }
+
+    fn finish_emitted(&mut self) {
+        self.active = false;
+    }
+}
+
+fn launch_task(task: &TaskConfig) -> bool {
+    task.task_name.as_deref() == Some("LaunchGame") || task.entry == "LaunchGameStart"
+}
+
+fn target_controller(windows: &[Win32Window], desktop: bool) -> Result<ControllerConfig, String> {
+    let window = windows
+        .iter()
+        .find(|window| {
+            window.handle != 0
+                && if desktop {
+                    window.class_name == "Progman"
+                } else {
+                    window.class_name == "UnrealWindow"
+                        && window.window_name.contains("洛克王国：世界")
+                }
+        })
+        .ok_or_else(|| {
+            if desktop {
+                "MaaRoco: Windows desktop window was not found [[hint:maaroco_desktop_window_missing]]".to_string()
+            } else {
+                "MaaRoco: game window was not found; run LaunchGame first [[hint:maaroco_game_window_missing]]".to_string()
+            }
+        })?;
+
+    Ok(ControllerConfig::Win32 {
+        handle: window.handle,
+        screencap_method: Win32ScreencapMethod::SCREEN_DC.bits(),
+        mouse_method: INTERCEPTION_INPUT,
+        keyboard_method: INTERCEPTION_INPUT,
+        display_short_side: Some(720),
+    })
+}
+
+fn ensure_queue_running(state: &MaaState, instance_id: &str) -> Result<(), String> {
+    let instances = state.instances.lock().map_err(|e| e.to_string())?;
+    let instance = instances.get(instance_id).ok_or("Instance not found")?;
+    if !instance.maaroco_queue.active || instance.maaroco_queue.cancelled {
+        return Err(QUEUE_CANCELLED.into());
+    }
+    Ok(())
+}
+
+async fn prepare_controller(
+    app: &tauri::AppHandle,
+    state: &Arc<MaaState>,
+    instance_id: &str,
+    task: &TaskConfig,
+) -> Result<(), String> {
+    ensure_queue_running(state, instance_id)?;
+    let windows = super::maa_core::find_win32_windows_impl(state.clone(), None, None).await?;
+    let config = target_controller(&windows, launch_task(task))?;
+
+    // Even an identical HWND may now belong to a newly started game process.
+    // Create a fresh controller instead of reusing the previous pool entry.
+    state.controller_pool.lock().map_err(|e| e.to_string())?.remove(&config);
+    ensure_queue_running(state, instance_id)?;
+    let app_for_callback = app.clone();
+    super::maa_core::connect_controller_impl(
+        state.clone(),
+        instance_id.to_owned(),
+        config,
+        Arc::new(move |message, details| {
+            super::utils::emit_callback_event(&app_for_callback, message, details);
+        }),
+    )
+    .await?;
+
+    let state = state.clone();
+    let instance_id_owned = instance_id.to_owned();
+    tokio::task::spawn_blocking(move || {
+        let deadline = Instant::now() + Duration::from_secs(30);
+        loop {
+            ensure_queue_running(&state, &instance_id_owned)?;
+            let connected = {
+                let instances = state.instances.lock().map_err(|e| e.to_string())?;
+                instances.get(&instance_id_owned)
+                    .and_then(|instance| instance.controller.as_ref())
+                    .is_some_and(|controller| controller.connected())
+            };
+            if connected {
+                return Ok::<(), String>(());
+            }
+            if Instant::now() >= deadline {
+                return Err("MaaRoco: controller connection timed out [[hint:maaroco_controller_connection_timeout]]".into());
+            }
+            std::thread::sleep(Duration::from_millis(50));
+        }
+    }).await.map_err(|e| e.to_string())??;
+    emit_state_changed(app, instance_id, "controller-connected");
+    Ok(())
+}
+
+async fn wait_for_task(tasker: Tasker, task_id: i64) -> Result<(), String> {
+    tokio::task::spawn_blocking(move || {
+        // get_task_detail hydrates every recognition and action in the task.
+        // Use the job's lightweight status wait for long battle/throw loops.
+        let status = Job::for_tasker(&tasker, task_id).wait();
+        while tasker.running() {
+            std::thread::sleep(Duration::from_millis(50));
+        }
+        if status == MaaStatus::SUCCEEDED {
+            Ok(())
+        } else {
+            Err(format!("MaaRoco task {} failed or was stopped", task_id))
+        }
+    }).await.map_err(|e| e.to_string())?
+}
+
+fn finish_queue(app: &tauri::AppHandle, state: &Arc<MaaState>, instance_id: &str, failed: bool) {
+    if let Err(error) = super::maa_agent::stop_agent_impl(state, instance_id) {
+        log::warn!("MaaRoco: failed to stop agent: {}", error);
+    }
+    let mut completed = false;
+    if let Ok(mut instances) = state.instances.lock() {
+        if let Some(instance) = instances.get_mut(instance_id) {
+            // Keep the queue active until its terminal notifications have been
+            // emitted, so a new run cannot overwrite the telemetry in between.
+            completed = instance.maaroco_queue.begin_finish();
+            let failed = failed || instance.maaroco_queue.cancelled;
+            for status in instance.task_run_state.statuses.values_mut() {
+                if status == "pending" || status == "running" {
+                    *status = "failed".into();
+                }
+            }
+            instance.task_run_state.overall_status = Some(if failed { "Failed" } else { "Succeeded" }.into());
+            instance.task_ids.clear();
+            instance.stop_in_progress = false;
+            instance.stop_started_at = None;
+        }
+    }
+    if completed {
+        super::telemetry::on_run_finished(instance_id);
+        emit_state_changed(app, instance_id, "tasks-completed");
+        if let Ok(mut instances) = state.instances.lock() {
+            if let Some(instance) = instances.get_mut(instance_id) {
+                if instance.maaroco_queue.completion_sent {
+                    instance.maaroco_queue.finish_emitted();
+                }
+            }
+        }
+    }
+}
+
+pub async fn start_tasks(
+    app: tauri::AppHandle,
+    state: &Arc<MaaState>,
+    instance_id: String,
+    tasks: Vec<TaskConfig>,
+    agent_configs: Option<Vec<AgentConfig>>,
+    cwd: String,
+    tcp_compat_mode: bool,
+    pi_envs: Option<HashMap<String, String>>,
+    controller_info: Option<ControllerInfo>,
+) -> Result<Vec<i64>, String> {
+    if !cfg!(windows) {
+        return Err("MaaRoco automatic controller selection requires Windows".into());
+    }
+    let app_config = app.try_state::<Arc<super::app_config::AppConfigState>>()
+        .ok_or("Project interface not loaded")?;
+    let is_maaroco = app_config.project_interface.lock().map_err(|e| e.to_string())?
+        .as_ref().and_then(|interface| interface.get("name"))
+        .and_then(|name| name.as_str()) == Some("MaaRoco");
+    if !is_maaroco {
+        return Err("Automatic task controllers are only available for MaaRoco".into());
+    }
+    if tasks.is_empty() {
+        return Err("MaaRoco task queue is empty".into());
+    }
+    {
+        let mut instances = state.instances.lock().map_err(|e| e.to_string())?;
+        let instance = instances.get_mut(&instance_id).ok_or("Instance not found")?;
+        if instance.tasker.as_ref().is_some_and(|tasker| tasker.running()) {
+            return Err("Instance is already running".into());
+        }
+        if !instance.resource.as_ref().is_some_and(|resource| resource.loaded()) {
+            return Err("Resource not loaded".into());
+        }
+        instance.maaroco_queue.begin()?;
+        instance.task_ids.clear();
+        instance.task_run_state = Default::default();
+        instance.task_run_state.overall_status = Some("Running".into());
+        for task in &tasks {
+            if let Some(selected_id) = &task.selected_task_id {
+                instance.task_run_state.statuses.insert(selected_id.clone(), "pending".into());
+            }
+        }
+    }
+    let task_names = tasks.iter().map(|task| task.task_name.clone().unwrap_or_else(|| task.entry.clone())).collect::<Vec<_>>();
+    super::telemetry::on_run_start(&instance_id, &task_names, controller_info.as_ref());
+    emit_state_changed(&app, &instance_id, "task-started");
+
+    let first_result = async {
+        super::maa_agent::stop_agent_impl(state, &instance_id)?;
+        prepare_controller(&app, state, &instance_id, &tasks[0]).await?;
+        ensure_queue_running(state, &instance_id)?;
+        super::maa_agent::start_tasks_batch_impl(
+            app.clone(), state, instance_id.clone(), vec![tasks[0].clone()],
+            agent_configs.clone(), cwd.clone(), tcp_compat_mode, pi_envs.clone(), false,
+            controller_info.clone(),
+        ).await
+    }.await;
+    let first_ids = match first_result {
+        Ok(ids) if ids.len() == 1 => ids,
+        Ok(_) => {
+            finish_queue(&app, state, &instance_id, true);
+            return Err("MaaRoco: failed to submit first task".into());
+        }
+        Err(error) => {
+            finish_queue(&app, state, &instance_id, true);
+            return Err(error);
+        }
+    };
+    let state = state.clone();
+    let initial_id = first_ids[0];
+    tauri::async_runtime::spawn(async move {
+        let mut result = async {
+            let mut task_id = initial_id;
+            for index in 0..tasks.len() {
+                let tasker = {
+                    let instances = state.instances.lock().map_err(|e| e.to_string())?;
+                    instances.get(&instance_id).and_then(|instance| instance.tasker.clone())
+                        .ok_or("Tasker not created")?
+                };
+                wait_for_task(tasker, task_id).await?;
+                ensure_queue_running(&state, &instance_id)?;
+                if let Some(next) = tasks.get(index + 1) {
+                    super::maa_agent::stop_agent_impl(&state, &instance_id)?;
+                    prepare_controller(&app, &state, &instance_id, next).await?;
+                    ensure_queue_running(&state, &instance_id)?;
+                    let ids = super::maa_agent::start_tasks_batch_impl(
+                        app.clone(), &state, instance_id.clone(), vec![next.clone()],
+                        agent_configs.clone(), cwd.clone(), tcp_compat_mode, pi_envs.clone(),
+                        false, controller_info.clone(),
+                    ).await?;
+                    task_id = *ids.first().ok_or("MaaRoco: failed to submit task")?;
+                }
+            }
+            Ok::<(), String>(())
+        }.await;
+        if result.is_err() {
+            let cancelled = state.instances.lock().ok()
+                .and_then(|instances| instances.get(&instance_id).map(|instance| instance.maaroco_queue.cancelled))
+                .unwrap_or(false);
+            if cancelled {
+                result = Err(QUEUE_CANCELLED.into());
+            }
+        }
+        if let Err(error) = &result {
+            log::warn!("MaaRoco queue finished with error: {}", error);
+            super::maa_agent::emit_agent_output(&app, &instance_id, "stderr", error);
+        }
+        finish_queue(&app, &state, &instance_id, result.is_err());
+    });
+    Ok(first_ids)
+}
+
+/// Native agents use the same MaaFramework DLLs as MXU, without .NET runtimes.
+pub fn agent_library_path() -> Option<std::ffi::OsString> {
+    let maafw = get_maafw_dir().ok()?;
+    let mut paths = vec![maafw];
+    paths.extend(std::env::split_paths(&std::env::var_os("PATH").unwrap_or_default()));
+    std::env::join_paths(paths).ok()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn task(entry: &str, task_name: Option<&str>) -> TaskConfig {
+        TaskConfig { entry: entry.into(), pipeline_override: "{}".into(), selected_task_id: None,
+            task_name: task_name.map(str::to_owned), options: None }
+    }
+
+    fn window(handle: u64, class: &str, title: &str) -> Win32Window {
+        Win32Window { handle, class_name: class.into(), window_name: title.into() }
+    }
+
+    #[test]
+    fn launching_uses_desktop_without_requiring_game() {
+        assert!(launch_task(&task("LaunchGameStart", None)));
+        assert!(launch_task(&task("DifferentEntry", Some("LaunchGame"))));
+        let config = target_controller(&[window(42, "Progman", "Program Manager")], true).unwrap();
+        assert_eq!(config, ControllerConfig::Win32 { handle: 42, screencap_method: 32,
+            mouse_method: 512, keyboard_method: 512, display_short_side: Some(720) });
+    }
+
+    #[test]
+    fn game_tasks_reject_desktop_other_games_and_null_windows() {
+        assert!(!launch_task(&task("BattleHostingStart", Some("BattleHosting"))));
+        let windows = vec![window(1, "Progman", "Program Manager"), window(2, "UnrealWindow", "Other Game"),
+            window(0, "UnrealWindow", "洛克王国：世界"), window(3, "UnrealWindow", "洛克王国：世界")];
+        assert!(matches!(target_controller(&windows, false).unwrap(), ControllerConfig::Win32 {handle: 3, ..}));
+        assert!(target_controller(&windows[..3], false).is_err());
+    }
+
+    #[test]
+    fn refreshed_game_handle_is_used_for_next_task() {
+        let before = target_controller(&[window(10, "UnrealWindow", "洛克王国：世界")], false).unwrap();
+        let after = target_controller(&[window(20, "UnrealWindow", "洛克王国：世界")], false).unwrap();
+        assert_ne!(before, after);
+    }
+
+    #[test]
+    fn cancelled_queue_cannot_be_replaced_before_worker_finishes() {
+        let mut queue = MaarocoQueue::default();
+        queue.begin().unwrap();
+        queue.cancel();
+        assert!(queue.active && queue.cancelled);
+        assert!(queue.begin().is_err());
+        assert!(queue.begin_finish());
+        assert!(queue.begin().is_err());
+        queue.finish_emitted();
+        queue.begin().unwrap();
+        assert!(!queue.cancelled);
+    }
+
+    #[test]
+    fn controller_transitions_keep_queue_running_and_delay_completion() {
+        let mut queue = MaarocoQueue::default();
+        assert!(!queue.is_running(false));
+        assert!(queue.callback_can_complete());
+        queue.begin().unwrap();
+        assert!(queue.is_running(false));
+        assert!(!queue.callback_can_complete());
+        queue.cancel();
+        assert!(queue.is_running(false));
+        assert!(queue.begin_finish());
+        assert!(queue.is_running(false));
+        queue.finish_emitted();
+        assert!(!queue.is_running(false));
+        assert!(!queue.callback_can_complete());
+        assert!(!queue.begin_finish());
+    }
+}
