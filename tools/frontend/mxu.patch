 /// 当前下载的 session ID，用于区分不同的下载任务
 static CURRENT_DOWNLOAD_SESSION: AtomicU64 = AtomicU64::new(0);
 
+const RELEASES_PER_PAGE: usize = 100;
+const MAX_STABLE_RELEASE_PAGES: usize = 10;
+
+// Keep publishing metadata local to the API response; callers still receive the
+// existing release DTO used by both the generic and MaaRoco update flows.
+#[derive(serde::Deserialize)]
+struct GitHubApiRelease {
+    #[serde(flatten)]
+    release: GitHubRelease,
+    draft: bool,
+    published_at: Option<String>,
+}
+
+impl GitHubApiRelease {
+    fn maaroco_stable_version(&self) -> Option<semver::Version> {
+        if self.draft
+            || self.release.prerelease
+            || self
+                .published_at
+                .as_ref()
+                .is_none_or(|published_at| published_at.trim().is_empty())
+        {
+            return None;
+        }
+
+        // Canonical vN.N.N tags exclude previews, build metadata and leading zeros.
+        // Versions below 1.0 are published MaaRoco releases as well.
+        let version = semver::Version::parse(self.release.tag_name.strip_prefix('v')?).ok()?;
+        if !version.pre.is_empty()
+            || !version.build.is_empty()
+            || self.release.tag_name != format!("v{}", version)
+        {
+            return None;
+        }
+
+        let asset_name = format!("MaaRoco-win-x86_64-{}.zip", self.release.tag_name);
+        self.release
+            .assets
+            .iter()
+            .any(|asset| {
+                asset.name == asset_name && !asset.browser_download_url.trim().is_empty()
+            })
+            .then_some(version)
+    }
+}
+
+fn retain_latest_stable_release(
+    best: &mut Option<(semver::Version, GitHubRelease)>,
+    releases: impl IntoIterator<Item = GitHubApiRelease>,
+) {
+    for release in releases {
+        let Some(version) = release.maaroco_stable_version() else {
+            continue;
+        };
+        if best.as_ref().is_none_or(|(current, _)| version > *current) {
+            *best = Some((version, release.release));
+        }
+    }
+}
+
+fn github_release_request(
+    client: &reqwest::Client,
+    url: &str,
+    github_pat: Option<&str>,
+) -> reqwest::RequestBuilder {
+    let mut request = client
+        .get(url)
+        .header(ACCEPT, "application/vnd.github.v3+json")
+        .header(USER_AGENT, "mxu");
+    if let Some(pat) = github_pat.filter(|pat| !pat.trim().is_empty()) {
+        request = request.header(AUTHORIZATION, format!("token {}", pat.trim()));
+    }
+    request
+}
+
+async fn get_latest_maaroco_release(
+    client: &reqwest::Client,
+    releases_url: &str,
+    github_pat: Option<&str>,
+) -> Result<Option<GitHubRelease>, String> {
+    // GitHub's latest endpoint excludes drafts and prereleases and remains cheap
+    // even when hundreds of preview releases precede a full release in the list.
+    let response = github_release_request(
+        client,
+        &format!("{}/latest", releases_url),
+        github_pat,
+    )
+    .send()
+    .await
+    .map_err(|e| format!("请求失败: {}", e))?;
+    if response.status().is_success() {
+        let release: GitHubApiRelease = response
+            .json()
+            .await
+            .map_err(|e| format!("解析 JSON 失败: {}", e))?;
+        if release.maaroco_stable_version().is_some() {
+            info!("找到最新正式 Release: {}", release.release.tag_name);
+            return Ok(Some(release.release));
+        }
+    } else if response.status() != reqwest::StatusCode::NOT_FOUND {
+        return Err(format!("GitHub API 错误: {}", response.status()));
+    }
+
+    // A release marked latest may use a preview tag or lack the Windows package.
+    // Search bounded pages for the highest eligible version rather than silently
+    // considering only GitHub's default first 30 releases.
+    let mut best = None;
+    for page in 1..=MAX_STABLE_RELEASE_PAGES {
+        let response = github_release_request(client, releases_url, github_pat)
+            .query(&[("per_page", RELEASES_PER_PAGE), ("page", page)])
+            .send()
+            .await
+            .map_err(|e| format!("请求失败: {}", e))?;
+        if !response.status().is_success() {
+            return Err(format!("GitHub API 错误: {}", response.status()));
+        }
+        let releases: Vec<GitHubApiRelease> = response
+            .json()
+            .await
+            .map_err(|e| format!("解析 JSON 失败: {}", e))?;
+        let is_last_page = releases.len() < RELEASES_PER_PAGE;
+        retain_latest_stable_release(&mut best, releases);
+        if is_last_page {
+            break;
+        }
+        if page == MAX_STABLE_RELEASE_PAGES {
+            warn!("正式 Release 查询达到分页上限: {}", page);
+        }
+    }
+    let release = best.map(|(_, release)| release);
+    if let Some(ref release) = release {
+        info!("找到匹配的正式 Release: {}", release.tag_name);
+    } else {
+        warn!("未找到带 Windows 安装包的正式 MaaRoco Release");
+    }
+    Ok(release)
+}
