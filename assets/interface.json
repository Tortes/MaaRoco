{
    "interface_version": 2,
    "name": "MaaRoco",
    "label": "MaaRoco",
    "title": "MaaRoco",
    "icon": "locales/MaaRoco.png",
    "description": "$project.description",
    "contact": "$project.contact",
    "license": "MIT",
    "github": "https://github.com/Tortes/MaaRoco",
    "version": "0.1.0",
    "languages": {
        "zh_cn": "locales/interface/zh_cn.json",
        "en_us": "locales/interface/en_us.json"
    },
    "controller": [
        {
            "name": "Win32-Interception",
            "label": "$controller.Win32-Interception.label",
            "description": "$controller.Win32-Interception.description",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": ".*",
                "screencap": "ScreenDC",
                "mouse": "Interception",
                "keyboard": "Interception"
            },
            "permission_required": true
        },
        {
            "name": "Win32-Launcher",
            "label": "$controller.Win32-Launcher.label",
            "description": "$controller.Win32-Launcher.description",
            "type": "Win32",
            "win32": {
                "class_regex": "^Progman$",
                "window_regex": ".*",
                "screencap": "ScreenDC",
                "mouse": "PostMessage",
                "keyboard": "PostMessage"
            }
        }
    ],
    "resource": [
        {
            "name": "default",
            "label": "$resource.default.label",
            "path": [
                "./resource"
            ]
        }
    ],
    "agent": {
        "child_exec": "./python/python.exe",
        "child_args": [
            "./agent/main.py"
        ]
    },
    "group": [
        {
            "name": "assist",
            "label": "$group.assist.label",
            "default_expand": true
        }
    ],
    "task": [],
    "import": [
        "tasks/LaunchGame.json",
        "tasks/BattleHosting.json",
        "tasks/FlowerSeedBattle.json",
        "tasks/RandomThrow.json",
        "tasks/TargetPetThrow.json"
    ]
}
