{
    "task": [
        {
            "name": "YueyaXuexiongThrow",
            "label": "$task.YueyaXuexiongThrow.label",
            "entry": "YueyaXuexiongThrowStart",
            "default_check": false,
            "description": "$task.YueyaXuexiongThrow.description",
            "option": [
                "YueyaXuexiongAimGain",
                "YueyaXuexiongCenterTolerance",
                "YueyaXuexiongThrowCooldown"
            ],
            "controller": [
                "Win32-Interception"
            ],
            "group": [
                "assist"
            ]
        },
        {
            "name": "YueyaXuexiongExploreThrow",
            "label": "$task.YueyaXuexiongExploreThrow.label",
            "entry": "YueyaXuexiongExploreStart",
            "default_check": false,
            "description": "$task.YueyaXuexiongExploreThrow.description",
            "option": [
                "YueyaXuexiongAimGain",
                "YueyaXuexiongCenterTolerance",
                "YueyaXuexiongThrowCooldown"
            ],
            "controller": [
                "Win32-Interception"
            ],
            "group": [
                "assist"
            ]
        }
    ],
    "option": {
        "YueyaXuexiongAimGain": {
            "type": "input",
            "label": "$option.YueyaXuexiongAimGain.label",
            "description": "$option.YueyaXuexiongAimGain.description",
            "inputs": [
                {
                    "name": "AimGainPercent",
                    "label": "$option.YueyaXuexiongAimGain.inputs.AimGainPercent.label",
                    "description": "$option.YueyaXuexiongAimGain.inputs.AimGainPercent.description",
                    "pipeline_type": "int",
                    "default": "100",
                    "verify": "^(?:[1-9]\\d?|[12]\\d{2}|300)$",
                    "pattern_msg": "$option.YueyaXuexiongAimGain.inputs.AimGainPercent.pattern_msg"
                }
            ],
            "pipeline_override": {
                "YueyaXuexiongDetect": {
                    "custom_action_param": {
                        "aim_gain_percent": "{AimGainPercent}"
                    }
                },
                "YueyaXuexiongExploreThrowDetect": {
                    "custom_action_param": {
                        "aim_gain_percent": "{AimGainPercent}"
                    }
                }
            }
        },
        "YueyaXuexiongCenterTolerance": {
            "type": "input",
            "label": "$option.YueyaXuexiongCenterTolerance.label",
            "description": "$option.YueyaXuexiongCenterTolerance.description",
            "inputs": [
                {
                    "name": "CenterTolerance",
                    "label": "$option.YueyaXuexiongCenterTolerance.inputs.CenterTolerance.label",
                    "description": "$option.YueyaXuexiongCenterTolerance.inputs.CenterTolerance.description",
                    "pipeline_type": "int",
                    "default": "24",
                    "verify": "^(?:[1-9]|[1-9]\\d|1\\d{2}|200)$",
                    "pattern_msg": "$option.YueyaXuexiongCenterTolerance.inputs.CenterTolerance.pattern_msg"
                }
            ],
            "pipeline_override": {
                "YueyaXuexiongDetect": {
                    "custom_action_param": {
                        "center_tolerance": "{CenterTolerance}"
                    }
                },
                "YueyaXuexiongExploreThrowDetect": {
                    "custom_action_param": {
                        "center_tolerance": "{CenterTolerance}"
                    }
                }
            }
        },
        "YueyaXuexiongThrowCooldown": {
            "type": "input",
            "label": "$option.YueyaXuexiongThrowCooldown.label",
            "description": "$option.YueyaXuexiongThrowCooldown.description",
            "inputs": [
                {
                    "name": "ThrowCooldown",
                    "label": "$option.YueyaXuexiongThrowCooldown.inputs.ThrowCooldown.label",
                    "description": "$option.YueyaXuexiongThrowCooldown.inputs.ThrowCooldown.description",
                    "pipeline_type": "int",
                    "default": "0",
                    "verify": "^(?:0|[1-9]\\d{0,3}|10000)$",
                    "pattern_msg": "$option.YueyaXuexiongThrowCooldown.inputs.ThrowCooldown.pattern_msg"
                }
            ],
            "pipeline_override": {
                "YueyaXuexiongDetect": {
                    "custom_action_param": {
                        "throw_cooldown_ms": "{ThrowCooldown}"
                    }
                },
                "YueyaXuexiongExploreThrowDetect": {
                    "custom_action_param": {
                        "throw_cooldown_ms": "{ThrowCooldown}"
                    }
                }
            }
        }
    }
}
