{
    "task": [
        {
            "name": "LaunchGame",
            "label": "$task.LaunchGame.label",
            "entry": "LaunchGameStart",
            "default_check": false,
            "description": "$task.LaunchGame.description",
            "option": [
                "WeGamePath",
                "WeGameLoginSource"
            ],
            "controller": [
                "Win32-Launcher"
            ],
            "group": [
                "assist"
            ]
        }
    ],
    "option": {
        "WeGamePath": {
            "type": "input",
            "label": "$option.WeGamePath.label",
            "description": "$option.WeGamePath.description",
            "inputs": [
                {
                    "name": "WeGameExecutable",
                    "label": "$option.WeGamePath.inputs.WeGameExecutable.label",
                    "description": "$option.WeGamePath.inputs.WeGameExecutable.description",
                    "pipeline_type": "string",
                    "default": "C:\\Program Files\\WeGame\\wegame.exe",
                    "verify": "^.+[\\\\/][Ww][Ee][Gg][Aa][Mm][Ee]\\.exe$",
                    "pattern_msg": "$option.WeGamePath.inputs.WeGameExecutable.pattern_msg"
                }
            ],
            "pipeline_override": {
                "LaunchGameStart": {
                    "action": {
                        "param": {
                            "exec": "{WeGameExecutable}"
                        }
                    }
                }
            }
        },
        "WeGameLoginSource": {
            "type": "select",
            "label": "$option.WeGameLoginSource.label",
            "description": "$option.WeGameLoginSource.description",
            "default_case": "QQ",
            "cases": [
                {
                    "name": "QQ",
                    "label": "$option.WeGameLoginSource.case.QQ.label",
                    "pipeline_override": {}
                },
                {
                    "name": "WeChat",
                    "label": "$option.WeGameLoginSource.case.WeChat.label",
                    "pipeline_override": {
                        "LaunchGameWaitForWindow": {
                            "custom_action_param": {
                                "wegame_click_entry": "LaunchGameClickWeGameStartWeChat",
                                "wegame_click_attempt_timeout_ms": 30000
                            }
                        }
                    }
                }
            ]
        }
    }
}
