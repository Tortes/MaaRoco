{
    "task": [
        {
            "name": "TargetPetSearchThrow",
            "label": "$task.TargetPetSearchThrow.label",
            "entry": "TargetPetThrowStart",
            "default_check": false,
            "description": "$task.TargetPetSearchThrow.description",
            "option": [
                "TargetPetModel"
            ],
            "controller": [
                "Win32-Interception"
            ],
            "group": [
                "assist"
            ]
        }
    ],
    "option": {
        "TargetPetModel": {
            "type": "select",
            "label": "$option.TargetPetModel.label",
            "description": "$option.TargetPetModel.description",
            "default_case": "YueyaXuexiong",
            "cases": [
                {
                    "name": "YueyaXuexiong",
                    "label": "$option.TargetPetModel.case.YueyaXuexiong.label",
                    "pipeline_override": {
                        "TargetPetAimDetect": {
                            "model": "yueya_xuexiong.onnx",
                            "threshold": 0.5
                        },
                        "TargetPetAimLoop": {
                            "custom_action_param": {
                                "target_recognition": "TargetPetAimDetect",
                                "aim_gain_percent": 100,
                                "center_tolerance": 200,
                                "settle_delay_ms": 10,
                                "verification_frames": 1,
                                "max_target_area_percent": 55,
                                "min_hold_ms": 20,
                                "throw_cooldown_ms": 0,
                                "detection_score_min": 0.5,
                                "locked_detection_score_min": 0.3,
                                "scan_step_units": 350,
                                "relative_aim_fast_step_units": 720,
                                "relative_aim_slow_step_units": 260,
                                "relative_aim_fine_step_units": 80,
                                "relative_aim_vertical_gain_percent": 180,
                                "relative_aim_slow_radius_px": 320,
                                "relative_aim_fine_radius_px": 120,
                                "aim_enter_delay_ms": 20,
                                "lost_grace_frames": 3,
                                "pitch_recovery_scan_frames": 4,
                                "pitch_recovery_step_units": 240,
                                "pitch_offset_limit_units": 900,
                                "pitch_recovery_min_offset_units": 80,
                                "target_lock_max_shift": 360
                            }
                        }
                    }
                },
                {
                    "name": "PipaBird",
                    "label": "$option.TargetPetModel.case.PipaBird.label",
                    "pipeline_override": {
                        "TargetPetAimDetect": {
                            "model": "pipa_bird.onnx",
                            "threshold": 0.1
                        },
                        "TargetPetAimLoop": {
                            "custom_action_param": {
                                "target_recognition": "TargetPetAimDetect",
                                "aim_gain_percent": 100,
                                "center_tolerance": 200,
                                "settle_delay_ms": 10,
                                "verification_frames": 1,
                                "max_target_area_percent": 55,
                                "min_hold_ms": 20,
                                "throw_cooldown_ms": 0,
                                "detection_score_min": 0.1,
                                "locked_detection_score_min": 0.1,
                                "scan_step_units": 350,
                                "relative_aim_fast_step_units": 720,
                                "relative_aim_slow_step_units": 260,
                                "relative_aim_fine_step_units": 80,
                                "relative_aim_vertical_gain_percent": 180,
                                "relative_aim_slow_radius_px": 320,
                                "relative_aim_fine_radius_px": 120,
                                "aim_enter_delay_ms": 20,
                                "lost_grace_frames": 3,
                                "pitch_recovery_scan_frames": 4,
                                "pitch_recovery_step_units": 240,
                                "pitch_offset_limit_units": 900,
                                "pitch_recovery_min_offset_units": 80,
                                "target_lock_max_shift": 360
                            }
                        }
                    }
                }
            ]
        }
    }
}
